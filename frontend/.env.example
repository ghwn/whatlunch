# Kakao API Keys
# Get your keys at: https://developers.kakao.com/

# REST API Key - used for server-side API calls (search restaurants)
VITE_KAKAO_REST_API_KEY=your_rest_api_key_here

# JavaScript Key - used for Kakao Maps SDK in index.html
# Note: Replace KAKAO_JS_KEY in index.html with your actual JS key
VITE_KAKAO_JS_KEY=your_js_key_here
